{
  "name": "calzup-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend do CalZup",
  "scripts": {
    "dev": "nodemon --exec tsx src/server.js",
    "start": "tsx src/server.js",
    "test": "node --test tests/*.test.js",
    "postinstall": "prisma generate && tsc --project tsconfig.build.json",
    "test:unit": "node --test tests/adminValidation.test.js tests/auth-pagination.test.js tests/sessionVersion.test.js tests/errorMiddleware.test.js tests/horario.unit.test.js tests/api-docs.test.js tests/api-contract.test.js",
    "test:http": "node --test tests/api-http.test.js tests/api-permissions.test.js",
    "test:api": "node --test tests/api-contract.test.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
